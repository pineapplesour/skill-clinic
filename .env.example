DAYTONA_TARGET=us
# Only needed to provision the Nosana GPU judge with nosana_deploy.py
NOSANA_API_KEY=
# Printed by `python nosana_deploy.py --wait`; unset => deterministic rules judge
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=x
