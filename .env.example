# Copy to .env and fill in. .env is gitignored and never uploaded to a sandbox.
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Only needed to provision the Nosana GPU judge with nosana_deploy.py
NOSANA_API_KEY=
# Printed by `.venv/bin/python nosana_deploy.py --wait`; unset => deterministic rules judge
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=x
# Optional: your own Pinata JWT for nosana_deploy.py IPFS pinning.
# Unset => the public, rate-limited nosana-kit default key is used.
NOSANA_PINATA_JWT=
